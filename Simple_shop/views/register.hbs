<!-- Login 9 - Bootstrap Brain Component -->
<section class="bg-primary" style="min-height: 100vh;">
  <div class="container d-flex justify-content-center py-4">
    <div class="col-9">
      <div class="card border-0 rounded-4">
        <div class="card-body p-3 p-md-4 p-xl-5">
          <div class="row">
            <div class="col-12">
              <div class="mb-2">
                <h3>Sign up</h3>
                <p>Have an account? <a href="/login">Login</a></p>
                <div class="alert alert-danger d-{{display}} mb-0" role="alert">
                  Username existed
                </div>
              </div>
            </div>
          </div>
          <form action="/register" method="POST">
            <div class="row gy-3 overflow-hidden">
              <div class="col-6">
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <input
                      type="text"
                      class="form-control"
                      name="username"
                      id="username"
                      value="{{data.username}}"
                      placeholder="name@example.com"
                      required
                    />
                    <label for="username" class="form-label">Username</label>
                  </div>
                </div>
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <input
                      type="password"
                      class="form-control"
                      name="password"
                      id="password"
                      value="{{data.password}}"
                      placeholder="Password"
                      required
                    />
                    <label for="password" class="form-label">Password</label>
                  </div>
                </div>
                <div class="col-12">
                  <div class="form-floating mb-2">
                    <input
                      type="password"
                      class="form-control"
                      name="password_retype"
                      id="password_retype"
                      value=""
                      placeholder="Retype Password"
                      required
                    />
                    <label for="password_retype" class="form-label">Retype
                      password</label>
                  </div>
                </div>
              </div>
              <div class="col-6">
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <input
                      type="text"
                      class="form-control"
                      name="email"
                      id="email"
                      value="{{data.email}}"
                      placeholder="name@example.com"
                      required
                    />
                    <label for="email" class="form-label">Email</label>
                  </div>
                </div>
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <input
                      type="text"
                      class="form-control"
                      name="name"
                      id="name"
                      value="{{data.name}}"
                      placeholder="name@example.com"
                      required
                    />
                    <label for="name" class="form-label">Your Name</label>
                  </div>
                </div>
                <div class="col-12">
                  <div class="form-floating mb-2">
                    <input
                      type="date"
                      class="form-control"
                      name="dob"
                      id="dob"
                      value="{{data.dob}}"
                      placeholder="name@example.com"
                      required
                    />
                    <label for="name" class="form-label">Date of birth</label>
                  </div>
                </div>
              </div>
              <div>
                <div class="d-grid">
                  <button class="btn btn-primary btn-lg" type="submit">Sign up
                    now</button>
                </div>
              </div>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</section>