<div class="d-flex justify-content-center">
  <div class="card" style="width: 400px; height: fit-content;">
    <div class="card-header text-center">
      <h2>Login</h2>
    </div>
    <div class="card-body needs-validation">
      <form class="row g-3" id="loginForm">
        <div class="col-12">
          <label for="username">Username</label>
          <input type="text" class="form-control" placeholder="Username" id="username" name="username" required />
        </div>
        <div class="col-12">
          <label for="password">Password</label>
          <input type="password" class="form-control" placeholder="Password" id="password" name="password" required />
        </div>
        <div class="col-12">
          <label for="tokenLife">Life time login</label>
          <select class="form-select" id="tokenLife" name="tokenLife">
            <option value="1" selected>1 day</option>
            <option value="15">15 days</option>
            <option value="30">30 days</option>
            <option value="45">45 days</option>
          </select>
        </div>
        <div class="col-12">
          <label class="mb-2">Data public:</label>
          <div class="d-flex gap-2">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="nickname" checked name="nickname">
              <label class="form-check-label" for="flexCheckIndeterminate">
                Nickname
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="avatar" checked name="avatar">
              <label class="form-check-label" for="flexCheckIndeterminate">
                Avatar
              </label>
            </div>
          </div>

        </div>
        <div class="col-12 feedback">
          <input type="hidden" class="form-control" />
          <div class="invalid-feedback">
          </div>
        </div>
        <div class="col-12">
          <button class="btn btn-primary w-100" type="submit">Login</button>
        </div>
        <div class="col-12">
          <span>Don't have an account? <a href="/auth/register">Register </a></span>
        </div>
      </form>
    </div>
  </div>
</div>

<script>

  $(document).ready(function () {
    $("#loginForm").on("submit", async function (e) {
      e.preventDefault();

      const data = $(this)
        .serializeArray()
        .reduce((obj, field) => ({ ...obj, [field.name]: field.value }), {});
      console.log(data);
      data.tokenLife = parseInt(data.tokenLife) * 24 * 60 * 60;

      const res = await fetch("/auth/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      const response = await res.json();
      if (response.success) {
        localStorage.setItem("accessToken", response.accessToken);
        localStorage.setItem("refreshToken", response.refreshToken);
        window.location.href = "/profile";
      } else {
        showToast(response.message || "Có lỗi xảy ra, hãy thử lại", "bg-danger")
      }
    })
  });
</script>