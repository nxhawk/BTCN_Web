<style>
  .emoji {
    cursor: context-menu;
    text-align: center;
    padding: 2px;
  }

  .emoji:hover {
    background-color: #5FBDFF;
    border-radius: 3px;
  }
</style>
<div>
  <div class="card">
    <h5 class="card-title mx-4 my-2">Chat box</h5>
    <div class="card-body" style="max-height: 400px; overflow-y:scroll">
      <ul id="chatbox">
      </ul>
    </div>
  </div>
  <form id="chat-form" class="d-flex gap-2 mt-2">
    <input type="text" id="chat-mess" class="form-control">
    <button id="send-chat" class="btn btn-primary">Send</button>
  </form>
  <p class="mt-2 mb-2">
    <button class="btn btn-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWidthExample"
      aria-expanded="false" aria-controls="collapseWidthExample">
      Emoji
    </button>
  </p>
  <div style="min-height: 120px;">
    <div class="collapse collapse-horizontal" id="collapseWidthExample">
      <div class="card card-body" style="width: 240px">
        <div class="d-flex flex-wrap" id="listEmoji">
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const listEmojiData = ["&#128512;", "&#128513;", "&#128514;", "&#128515;", "&#128516;", "&#128517;", "&#128564;", "&#128557;", "&#128561;", "&#128564;", "&#128525;", "&#129327;", "&#129392;", "&#129398;", "&#129402;", "&#129322;", "&#129323;", "&#129300;", "&#128561;", "&#128545;", "&#128542;", "&#128528;", "&#128526;", "&#129315;"]

  document.getElementById("send-chat").addEventListener("click", function (e) {
    e.preventDefault();
    let mess = document.getElementById("chat-mess").value.trim();
    if (mess.length > 0) {
      const username = document.querySelector("#username").textContent;
      if (username.length < 0) {
        window.location.href = "https:/localhost:3003/auth/login";
      }
      mess = `<b>${username}</b>: ${mess}`;
      socket.emit("message", { message: mess });
    }
    document.getElementById("chat-mess").value = ""
  });

  socket.on("message", data => {
    document.getElementById("chatbox").innerHTML += `<li>${data}</li>`;
  });

  function addEmoji(element) {
    const emoji = $(element).attr("data-emoji");
    const currentMess = document.getElementById('chat-mess');
    currentMess.value += emoji;
  }

  document.addEventListener("DOMContentLoaded", async function () {
    let list_emoji = document.getElementById("listEmoji");
    list_emoji.innerHTML = "";
    for (em of listEmojiData)
      list_emoji.innerHTML += `<span class="emoji" data-emoji=${em} onclick="addEmoji(this)">${em}</span>`
  })
</script>