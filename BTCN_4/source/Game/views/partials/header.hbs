<nav class="navbar bg-light p-2 mt-2 mb-2 rounded-2 p-3">
  <div class="container-fluid">
    <a class="navbar-brand mb-0 h1" href="/">Tic-tac-toe</a>
    <nav style="--bs-breadcrumb-divider: '|';" aria-label="breadcrumb">

      <ol class="breadcrumb d-flex align-items-center m-0">
        {{#if isLogin}}
        {{#if (uisPlaying isPlaying)}}
        <div style="visibility: hidden;" id="gameST">game</div>
        <button type="button" class="btn btn-primary">
          <a href="/board/{{isPlaying}}" class="text-white" style="text-decoration: none;">Game</a>
        </button>
        {{else}}
        <div style="visibility: hidden;" id="gameST"></div>
        <button type="button" class="btn btn-primary" id="newgame" data-bs-toggle="modal"
          data-bs-target="#exampleModal">New
          game</button>
        {{/if}}
        <div style="margin-left: 10px;">Hello <b id="abs">{{username}}</b></div>
        <div class="dropdown mx-2">
          <div class="dropdown-toggle d-flex align-items-center hidden-arrow" href="#" id="navbarDropdownMenuAvatar"
            role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="rounded-circle fa fa-user-circle fa-2x"></i>
          </div>
          <ul class="dropdown-menu">
            <li>
              <a class="dropdown-item" href="/board/history">Lịch sử chơi</a>
            </li>
            <li>
              <a class="dropdown-item" href="https://localhost:3003/profile">Profile</a>
            </li>
            <li>
              <button class="dropdown-item" id="logout">Log out</button>
            </li>

          </ul>
        </div>
        {{else}}
        <a class="breadcrumb-item nav-link" href="https://localhost:3003/auth/login">Login</a>
        <a class="breadcrumb-item nav-link" href="https://localhost:3003/auth/register">Register</a>
        {{/if}}
      </ol>

    </nav>
  </div>

  {{!-- modal --}}
  <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="exampleModalLabel">Create new game</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">

          <label for="">Board Size :</label>
          <select class="form-select" id="sizeBoard">
            <option value="3" selected>3x3</option>
            <option value="5">5x5</option>
            <option value="7">7x7</option>
            <option value="9">9x9</option>
            <option value="11">11x11</option>
            <option value="13">13x13</option>
            <option value="15">15x15</option>
          </select>
          <label for="" class="mt-2">Time: </label>
          <select class="form-select" id="time">
            <option value="10000" selected>10 giay</option>
            <option value="20000">20 giay</option>
            <option value="30000">30 giay</option>
            <option value="40000">20 giay</option>
            <option value="50000">30 giay</option>
            <option value="60000">1 phut</option>
            <option value="120000">2 phut</option>
          </select>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" id="create">Create</button>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  document.getElementById("create").addEventListener("click", async function () {
    const size = document.getElementById("sizeBoard").value;
    const time = document.getElementById("time").value

    const data = {
      time,
      size
    }
    const res = await fetch("/board/create", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(data),
    });
    const response = await res.json();
    socket.emit("newboard", { name: response });
    window.location.href = `/board/${response}`;
  })

</script>